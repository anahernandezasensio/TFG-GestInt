# ============================================================
# GestInt — Dunder Mifflin Paper Company
# Configuración de seguridad Apache (.htaccess raíz)
# ============================================================

# Ocultar el listado de archivos de los directorios
Options -Indexes

# Bloquear acceso directo a archivos críticos por extensión
<FilesMatch "\.(sql|env|log|bak|conf|config|ini|sh)$">
    Require all denied
</FilesMatch>

# Bloquear acceso al propio .htaccess
<Files ".htaccess">
    Require all denied
</Files>

# Cabeceras de seguridad HTTP
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
